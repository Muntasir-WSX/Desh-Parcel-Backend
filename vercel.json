{
  "version": 2,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npx prisma generate --schema=prisma/schema.prisma",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
